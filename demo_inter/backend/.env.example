DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inter_academy?schema=public"
PORT=4000
NODE_ENV=development

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# 32-byte (64 hex char) key used for pgcrypto pgp_sym_encrypt/decrypt of TC numbers.
TC_ENCRYPTION_KEY="change-me-32-byte-hex-key-0000000000000000000000000000"

# Seed admin passwords (plaintext only used once by the seed script to produce bcrypt/argon2 hashes; never stored raw).
SEED_ADMIN1_PASSWORD="inter_pass_10"
SEED_ADMIN2_PASSWORD="inter_pass_20"
SEED_ADMIN3_PASSWORD="inter_pass_30"

# WhatsApp Business Cloud API (leave blank to fall back to logging-only stub sender)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v19.0"
# Webhook kurarken Meta panelinde "Verify Token" alanına bununla aynı değeri gir.
WHATSAPP_VERIFY_TOKEN="change-me-to-a-random-string"
# Opsiyonel ama önerilir: webhook isteklerinin imzasını (X-Hub-Signature-256) doğrulamak için App Secret.
WHATSAPP_APP_SECRET=""

CORS_ORIGIN="http://localhost:5173"
